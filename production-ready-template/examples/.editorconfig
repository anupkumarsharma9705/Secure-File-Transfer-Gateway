root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{java,kt,cs}]
indent_size = 4

[*.{md,yml,yaml,json,jsonc,toml}]
indent_size = 2

[Dockerfile]
indent_size = 2

[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

[Makefile]
indent_style = tab