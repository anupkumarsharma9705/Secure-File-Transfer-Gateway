# Caddyfile — automatic HTTPS for the SFTG production stack.
#
# DOMAIN is read from the container environment (docker-compose.prod profile):
#   DOMAIN=files.example.com   -> automatic Let's Encrypt certificate
#   DOMAIN=:80                 -> HTTP only (testing; NOT for production)
#
# Caddy is the only public entry point. It proxies everything to the frontend
# nginx container, which serves the SPA and proxies /api to the backend.
{$DOMAIN} {
    encode zstd gzip

    reverse_proxy frontend:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format console
    }
}
