# ============================================================
# SFTG — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/SFTG?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=your_db_user
DB_PASSWORD=your_strong_db_password

# ---- JWT ----
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_BYTE_BASE64_SECRET
JWT_EXPIRATION_MS=7200000

# ---- VirusTotal (malware scanning; leave blank to disable scans) ----
# Free key: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key
# Optional tuning (defaults shown)
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_UPLOAD_UNKNOWN=true
VIRUSTOTAL_POLL_ATTEMPTS=2
VIRUSTOTAL_POLL_INTERVAL_MS=20000

# ---- Email (Brevo) ----
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_user@example.com
MAIL_PASSWORD=your_brevo_smtp_password
BREVO_API_KEY=your_brevo_api_key

# ---- CORS ----
# Public frontend origin. With the same-origin nginx proxy this is only used
# for direct API clients, but set it to your real URL in production.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ---- Frontend (build-time) ----
# Keep /api for the Docker stack: nginx proxies /api/ to the backend on the
# same origin. Use an absolute URL only when frontend/backend are separate hosts.
VITE_API_URL=/api

# ---- Host ports (docker compose) ----
# When using the Caddy `tls` profile, set FRONTEND_PORT=8081 so Caddy can
# bind host ports 80/443.
FRONTEND_PORT=80
BACKEND_PORT=8000
MYSQL_PORT=3306

# ---- Public TLS domain (docker compose --profile tls) ----
# files.example.com -> automatic HTTPS (DNS A record must point here).
# Use :80 for HTTP-only testing; never for production.
DOMAIN=:80

# ---- App ----
SERVER_PORT=8000
